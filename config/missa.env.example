# Beispiel-Konfiguration für Missa-Core.
# Kopieren nach /etc/missa/missa.env und anpassen:
#   sudo install -m 640 -o root -g missa config/missa.env.example /etc/missa/missa.env
# Echte Schlüssel und Passwörter gehören nur in /etc/missa/missa.env, nie ins Repo!
#
# Jeder Dienst bekommt eigene Zugangsdaten mit so wenig Rechten wie möglich.
# Welche Rechte genau nötig sind, steht in docs/rechte.md und am Anfang jedes Blocks.

# --- Missa-Core -------------------------------------------------------------

# Adresse und Port, auf denen die API lauscht (nur internes Netz, HTTPS macht Caddy).
MISSA_HOST=0.0.0.0
MISSA_PORT=8000

# Pflicht: Bearer-Token für alle Apps. Erzeugen z. B. mit:  openssl rand -hex 32
MISSA_API_KEY=bitte-aendern

# Charakter von Missa (wird bei jeder Anfrage neu gelesen).
MISSA_CHARAKTER_DATEI=/etc/missa/charakter.md

# Ordner für Laufzeitdaten (SQLite-Datenbank missa.db).
MISSA_DATEN=/opt/missa/data

# Zeitzone für Datum und Uhrzeit (Systemprompt, Termine, Erinnerungen).
TIMEZONE=Europe/Zurich

# Optional: Ausführlichkeit der Logs (DEBUG, INFO, WARNING, ERROR).
#MISSA_LOG_LEVEL=INFO

# --- Rechte und Notfall-Stopp (siehe docs/rechte.md) --------------------------
# Optional: So viele Minuten gilt eine Rückfrage vor einer zerstörerischen Aktion
# (löschen, verwerfen, senden). Danach muss Missa neu fragen.
MISSA_BESTAETIGUNG_MINUTEN=10
# Der Notfall-Stopp hat keine Einstellung: Er ist aktiv, solange die Datei
# MISSA_DATEN/notfall-stopp existiert (sudo scripts/notfall-stopp.sh bzw. notfall-freigabe.sh).

# --- llama-server -------------------------------------------------------------
# Rechte: Der Schlüssel erlaubt nur Anfragen an das lokale Modell (llama-server --api-key).

# Adresse von llama-server (läuft mit --jinja auf demselben Rechner).
LLAMA_URL=http://127.0.0.1:8080

# Datei mit dem API-Key von llama-server (falls llama-server mit --api-key läuft).
LLAMA_API_KEY_FILE=/etc/missa/llama.key

# Optional: Wie lange (Sekunden) auf eine Antwort gewartet wird. Auf der CPU großzügig wählen.
#LLAMA_TIMEOUT=600

# --- Nextcloud (Kalender und Aufgaben) ----------------------------------------
# Ohne URL, Benutzer und App-Passwort sind die Nextcloud-Werkzeuge ausgeschaltet.
# Rechte: eigenes App-Passwort nur für Missa (jederzeit einzeln widerrufbar), nur CalDAV/CardDAV
# nötig. Besser: eigener Benutzer „missa“, mit dem du nur die nötigen Kalender, die Aufgabenliste
# und das Adressbuch teilst – nie ein Admin-Konto.

# Adresse von Nextcloud ohne /remote.php/dav (wird automatisch angehängt).
NEXTCLOUD_URL=https://cloud.example.ch
NEXTCLOUD_USER=louis
# App-Passwort: Nextcloud → Einstellungen → Sicherheit → „Neues App-Passwort erstellen“.
NEXTCLOUD_APP_PASSWORD=bitte-aendern
# Anzeigename des Kalenders, so wie er in Nextcloud heißt.
NEXTCLOUD_KALENDER=Persönlich
# Anzeigename der Liste in der Nextcloud-App „Aufgaben“.
NEXTCLOUD_AUFGABEN_LISTE=Aufgaben
# Optional: Anzeigename des Adressbuchs für Geburtstage und Kontaktpflege. Leer = alle Adressbücher.
NEXTCLOUD_ADRESSBUCH=
# Optional: So viele Tage vor einem Geburtstag erinnert Missa (zusätzlich am Tag selbst).
KONTAKTE_GEBURTSTAG_VORLAUF=3
# Optional: Uhrzeit, zu der Missa täglich Geburtstage und Kontaktpflege prüft (und erinnert).
KONTAKTE_PRUEFZEIT=08:00

# --- Pausen und Puffer im Kalender (siehe docs/pausen.md) ---------------------
# Optional: Pausen-Wächter ein (true) oder aus (false). Braucht NEXTCLOUD_KALENDER.
PAUSEN_AKTIV=true
# Optional: Kalender für Missas Puffer- und Pausenblöcke (wird bei Bedarf angelegt) und seine Farbe.
PAUSEN_KALENDER=Pausen
# Optional: Farbe des Pausen-Kalenders und der Blöcke (z. B. türkis, hellgrün, #40E0D0).
PAUSEN_FARBE=türkis
# Optional: Mindest-Puffer zwischen zwei Terminen (Minuten).
PAUSEN_PUFFER_MINUTEN=10
# Optional: Länge der Mittagspause (Minuten) und das Zeitfenster dafür.
PAUSEN_MITTAG_MINUTEN=30
# Optional: Frühester Beginn der Mittagspause.
PAUSEN_MITTAG_VON=11:30
# Optional: Spätestes Ende der Mittagspause.
PAUSEN_MITTAG_BIS=14:00
# Optional: Ab so vielen Stunden Terminen gilt ein Tag als zu voll.
PAUSEN_MAX_STUNDEN=8
# Optional: Mindest-Wegzeit zwischen Terminen an verschiedenen Orten (Minuten).
PAUSEN_WEGZEIT_MINUTEN=30
# Optional: Uhrzeit, zu der Missa jeden Abend den nächsten Tag prüft.
PAUSEN_PRUEFZEIT=19:00

# --- Nachtschicht: lange Aufgaben nachts erledigen (siehe docs/routinen-nachtschicht.md) ----
# Optional: Beginn des Nachtfensters. Im Gespräch geänderte Zeiten („Nachtschicht von 2 bis 5“)
# werden in der Datenbank gespeichert und haben Vorrang vor diesem Wert.
NACHTSCHICHT_VON=01:00
# Optional: Ende des Nachtfensters; zu dieser Zeit kommt auch der Morgenbericht.
NACHTSCHICHT_BIS=06:00

# --- Nextcloud Talk: Missa als Bot in einer Talk-Unterhaltung -----------------
# Einrichtung: docs/nextcloud-talk.md. Solange NC_TALK_ENABLED=false ist oder
# NC_TALK_BASE_URL bzw. NC_TALK_BOT_SECRET fehlen, ist Talk aus und Missa startet normal.
# Rechte: Das Bot-Secret gilt nur für den Bot (Nachrichten und Reaktionen in Unterhaltungen, in
# denen der Bot aktiviert ist) – kein Benutzer-Passwort, kein Zugriff auf Dateien.
# Talk einschalten (true) oder ausschalten (false).
NC_TALK_ENABLED=false
# Adresse von Nextcloud genau wie "overwrite.cli.url" in der config.php von Nextcloud,
# z. B. https://cloud.louis-degiorgi.ch:8443 – damit prüft Missa, woher ein Webhook kommt.
NC_TALK_BASE_URL=
# Optional: Adresse, über die ai01 Nextcloud für Antworten erreicht, falls anders als
# NC_TALK_BASE_URL (z. B. intern http://10.0.30.10). Leer = NC_TALK_BASE_URL.
NC_TALK_API_URL=
# Gemeinsames Geheimnis des Bots (40–128 Zeichen). Erzeugen mit: openssl rand -hex 32
# Derselbe Wert kommt in "occ talk:bot:install".
NC_TALK_BOT_SECRET=
# Nur diese Accounts dürfen mit Missa sprechen, echte Nextcloud-Benutzer-IDs eintragen
# (kommagetrennt, Beispiel: louis,admin). Leer = Missa ignoriert alle Talk-Nachrichten.
NC_TALK_ALLOWED_USERS=
# Wie lange (Sekunden) Missa höchstens an einer Talk-Antwort arbeitet.
NC_TALK_TIMEOUT=300
# Optional: Token der Talk-Unterhaltung, in die Missa von sich aus schreiben darf (z. B.
# Erinnerungen). Steht in der Adresse: .../call/<token>. Leer = Missa schreibt nicht von sich aus
# (Erinnerungen werden dann gespeichert, aber erst zugestellt, wenn der Wert gesetzt ist).
NC_TALK_NOTIFY_CONVERSATION=
# Höchstens so viele Nachrichten pro Minute schreibt Missa von sich aus (Schutz vor Fluten).
NC_TALK_NOTIFY_RATE=10

# --- E-Mail: Entwürfe im eigenen Stil (IMAP/SMTP des eigenen Mailservers) ------
# Siehe docs/email.md. Ohne IMAP, SMTP, Benutzer und Passwort ist E-Mail aus.
# Missa schreibt nur Entwürfe – gesendet wird erst nach deinem ausdrücklichen Ja.
# Rechte: eigenes App-Passwort des Mailkontos (falls der Server das kann), IMAP für Lesen und
# Entwürfe, SMTP nur zum Senden des bestätigten Entwurfs. Keine Weiterleitungs- oder Filterregeln.
# Optional: IMAP-Server (TLS) und Port.
MAIL_IMAP_HOST=
# Optional: Port des IMAP-Servers (993 = TLS).
MAIL_IMAP_PORT=993
# Optional: SMTP-Server zum Senden.
MAIL_SMTP_HOST=
# Optional: Port des SMTP-Servers (465 = TLS, 587 = STARTTLS).
MAIL_SMTP_PORT=465
# Optional: Benutzername des Mailkontos (meist die Adresse).
MAIL_USER=
# Optional: Passwort bzw. App-Passwort des Mailkontos – nur hier eintragen, nie ins Repo!
MAIL_PASSWORD=
# Optional: Absender mit Namen, z. B. Louis Degiorgi <louis@example.ch>. Leer = MAIL_USER.
MAIL_ABSENDER=
# Optional: IMAP-Ordner für Entwürfe und gesendete Mails (Namen wie auf dem Server).
MAIL_ORDNER_ENTWUERFE=Drafts
# Optional: IMAP-Ordner der gesendeten Mails (daraus lernt Missa deinen Stil).
MAIL_ORDNER_GESENDET=Sent
# Optional: Datei mit deinem Schreibstil-Profil (frei bearbeitbar). Leer = MISSA_DATEN/schreibstil.md
MAIL_STIL_DATEI=

# --- Server-Alarme und Monitoring (siehe docs/server-alarme.md, docs/monitoring.md) -----
# Ohne Quelle (MONITORING_URL, HOMEPAGE_URL oder Proxmox) sind die Server-Alarme aus.
# Alles nur lesend. Nötige Netzfreigaben von ai01 aus: docs/netzfreigaben.md.
# Optional: Adresse deines eigenen Monitoring-Tools, die Messwerte als JSON liefert (Format in
# docs/monitoring.md), z. B. http://10.0.30.20:9100/api/werte. Leer = aus.
MONITORING_URL=
# Optional: Bearer-Token für MONITORING_URL, falls das Tool eins verlangt (nur lesen).
MONITORING_TOKEN=
# Optional: Adresse des Homepage-Dashboards (gethomepage.dev), z. B. http://10.0.30.20:3000.
# Missa liest den Status aller Dienste mit „siteMonitor“. Leer = aus.
HOMEPAGE_URL=
# Optional: Proxmox-API für CPU, RAM und Disk pro VM, z. B. https://pve-id01.lan:8006. Leer = aus.
# Rechte: nur lesendes API-Token mit Rolle PVEAuditor (scripts/einrichten/proxmox-lesetoken.sh).
PROXMOX_URL=
# Optional: Token-ID, so wie das Einrichtungs-Script sie ausgibt.
PROXMOX_TOKEN_ID=missa@pve!monitor
# Optional: Secret des Tokens – nur hier eintragen, nie ins Repo!
PROXMOX_TOKEN_SECRET=
# Optional: Zertifikat von Proxmox prüfen (true). Mit dem selbstsignierten Standard-Zertifikat
# entweder PROXMOX_CA_DATEI setzen (empfohlen) oder notfalls false.
PROXMOX_TLS_PRUEFEN=true
# Optional: CA-Datei für Proxmox, z. B. /etc/missa/proxmox-ca.pem (von pve-id01:
# /etc/pve/pve-root-ca.pem). Leer = System-Zertifikate.
PROXMOX_CA_DATEI=
# Optional: So oft (Sekunden) holt Missa die Messwerte (mindestens 10).
MONITORING_INTERVALL_SEKUNDEN=60
# Optional: Standard-Dauer einer Regel: so lange muss ein Wert über der Grenze liegen (Minuten).
ALARM_DAUER_MINUTEN=5
# Optional: Derselbe Alarm kommt frühestens nach so vielen Minuten wieder (Ruhefenster).
# Im Gespräch änderbar („Wiederhol Alarme höchstens alle 2 Stunden“).
ALARM_RUHEFENSTER_MINUTEN=60
# Optional: Ruhezeit: info und wichtig warten bis zum Ende, Notfälle kommen immer sofort.
# Im Gespräch änderbar; „aus“ = keine Ruhezeit.
ALARM_RUHEZEIT_VON=22:00
# Optional: Ende der Ruhezeit.
ALARM_RUHEZEIT_BIS=07:00
# Optional: Hinweise auf ungewöhnliche Anstiege unter den Grenzen (Vergleich mit dem
# 7-Tage-Mittel derselben Tageszeit) ein (true) oder aus (false).
AUFFAELLIG_AKTIV=true
# Optional: So viele Prozentpunkte über dem Üblichen gelten als auffällig (doppelt = wichtig).
AUFFAELLIG_MIN_ABSTAND=15

# --- Erreichbarkeit von außen (siehe docs/server-alarme.md) --------------------
# Optional: Diese Domains prüft Missa regelmäßig über die öffentliche Adresse (DNS, HTTPS-Antwort,
# gültiges Zertifikat), kommagetrennt. Leer = aus.
ERREICHBARKEIT_DOMAINS=cloud.louis-degiorgi.ch,git.louis-degiorgi.ch,ki.louis-degiorgi.ch
# Optional: So oft (Minuten) wird geprüft. Ein Ausfall gilt nach zwei Fehlschlägen hintereinander.
ERREICHBARKEIT_INTERVALL_MINUTEN=5
# Optional: Stufe für einen Ausfall (info, wichtig oder notfall). Die Rückkehr kommt als info.
ERREICHBARKEIT_STUFE=wichtig
