# Beispiel-Konfiguration für Missa-Core.
# Kopieren nach /etc/missa/missa.env und anpassen:
#   sudo install -m 640 -o root -g missa config/missa.env.example /etc/missa/missa.env
# Echte Schlüssel und Passwörter gehören nur in /etc/missa/missa.env, nie ins Repo!

# --- Missa-Core -------------------------------------------------------------

# Adresse und Port, auf denen die API lauscht (nur internes Netz, HTTPS macht Caddy).
MISSA_HOST=0.0.0.0
MISSA_PORT=8000

# Pflicht: Bearer-Token für alle Apps. Erzeugen z. B. mit:  openssl rand -hex 32
MISSA_API_KEY=bitte-aendern

# Charakter von Missa (wird bei jeder Anfrage neu gelesen).
MISSA_CHARAKTER_DATEI=/etc/missa/charakter.md

# Ordner für Laufzeitdaten (SQLite-Datenbank missa.db).
MISSA_DATEN=/opt/missa/data

# Zeitzone für Datum und Uhrzeit im Systemprompt.
TIMEZONE=Europe/Zurich

# Optional: Ausführlichkeit der Logs (DEBUG, INFO, WARNING, ERROR).
#MISSA_LOG_LEVEL=INFO

# --- llama-server -------------------------------------------------------------

# Adresse von llama-server (läuft mit --jinja auf demselben Rechner).
LLAMA_URL=http://127.0.0.1:8080

# Datei mit dem API-Key von llama-server (falls llama-server mit --api-key läuft).
LLAMA_API_KEY_FILE=/etc/missa/llama.key

# Optional: Wie lange (Sekunden) auf eine Antwort gewartet wird. Auf der CPU großzügig wählen.
#LLAMA_TIMEOUT=600

# --- Nextcloud (Kalender und Aufgaben) ----------------------------------------
# Ohne URL, Benutzer und App-Passwort sind die Nextcloud-Werkzeuge ausgeschaltet.

# Adresse von Nextcloud ohne /remote.php/dav (wird automatisch angehängt).
NEXTCLOUD_URL=https://cloud.example.ch
NEXTCLOUD_USER=louis
# App-Passwort: Nextcloud → Einstellungen → Sicherheit → „Neues App-Passwort erstellen“.
NEXTCLOUD_APP_PASSWORD=bitte-aendern
# Anzeigename des Kalenders, so wie er in Nextcloud heißt.
NEXTCLOUD_KALENDER=Persönlich
# Anzeigename der Liste in der Nextcloud-App „Aufgaben“.
NEXTCLOUD_AUFGABEN_LISTE=Aufgaben

# --- Nextcloud Talk: Missa als Bot in einer Talk-Unterhaltung -----------------
# Einrichtung: docs/nextcloud-talk.md. Solange NC_TALK_ENABLED=false ist oder
# NC_TALK_BASE_URL bzw. NC_TALK_BOT_SECRET fehlen, ist Talk aus und Missa startet normal.
# Talk einschalten (true) oder ausschalten (false).
NC_TALK_ENABLED=false
# Adresse von Nextcloud genau wie "overwrite.cli.url" in der config.php von Nextcloud,
# z. B. https://cloud.louis-degiorgi.ch:8443 – damit prüft Missa, woher ein Webhook kommt.
NC_TALK_BASE_URL=
# Optional: Adresse, über die ai01 Nextcloud für Antworten erreicht, falls anders als
# NC_TALK_BASE_URL (z. B. intern http://10.0.30.10). Leer = NC_TALK_BASE_URL.
NC_TALK_API_URL=
# Gemeinsames Geheimnis des Bots (40–128 Zeichen). Erzeugen mit: openssl rand -hex 32
# Derselbe Wert kommt in "occ talk:bot:install".
NC_TALK_BOT_SECRET=
# Nur diese Accounts dürfen mit Missa sprechen, echte Nextcloud-Benutzer-IDs eintragen
# (kommagetrennt, Beispiel: louis,admin). Leer = Missa ignoriert alle Talk-Nachrichten.
NC_TALK_ALLOWED_USERS=
# Wie lange (Sekunden) Missa höchstens an einer Talk-Antwort arbeitet.
NC_TALK_TIMEOUT=300
# Optional: Token der Talk-Unterhaltung, in die Missa von sich aus schreiben darf (z. B.
# Erinnerungen). Steht in der Adresse: .../call/<token>. Leer = Missa schreibt nicht von sich aus.
NC_TALK_NOTIFY_CONVERSATION=
# Höchstens so viele Nachrichten pro Minute schreibt Missa von sich aus (Schutz vor Fluten).
NC_TALK_NOTIFY_RATE=10
