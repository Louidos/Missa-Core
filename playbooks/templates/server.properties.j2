# Verwaltet von Missa (playbooks/minecraft.yml) – Änderungen hier gehen beim nächsten Lauf verloren.
motd={{ minecraft_motd }}
server-port={{ minecraft_port }}
max-players={{ minecraft_max_spieler }}
difficulty={{ minecraft_schwierigkeit }}
white-list=true
enforce-whitelist=true
enable-rcon=true
rcon.port={{ rcon_port }}
rcon.password={{ rcon_passwort }}
broadcast-rcon-to-ops=false
view-distance=10
simulation-distance=10
level-name=world
